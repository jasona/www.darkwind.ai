    {
      "id": "stage3",
      "number": 3,
      "title": "Choose Your Path",
      "levelRange": null,
      "paragraphs": [
        "Once the farm feels easy, pick a guild -- it defines your abilities for the climb ahead. Browse the roster, the playstyle archetypes, and which pairings work before committing.",
        "Level at the adventurers guild with advance; experience costs grow with each level, and your stats shape what your abilities can do."
      ],
      "commands": [
        "advance"
      ],
